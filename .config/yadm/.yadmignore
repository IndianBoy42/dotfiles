# Paths excluded from `yadm add` / `yadm status`.
# The yadm work tree IS $HOME, so anything noisy or separately versioned has to be listed
# here or it shows up as an untracked pile on every `yadm status`.

# --- separately versioned repos that live in $HOME ---
.omp/            # github.com/IndianBoy42/dot-omp
qmk_userspace/   # kanata config + keyboard firmware
.config/nvim/    # lazyvim fork

# --- credentials; sourced by fish from ~/.env ---
.env
.config/gh/

# --- caches and runtime state ---
.cache/
.local/state/
.local/share/nvim/
.local/share/Trash/
.local/share/containers/
.local/share/plasma/
.local/share/kactivitymanagerd/
.local/share/baloo/
.cargo/registry/
.cargo/git/
.rustup/toolchains/
.rustup/downloads/
.bun/
.mozilla/
node_modules/
.gradle/
.npm/
*.log


# --- fisher-managed fish plugin files ---
# These belong to `fisher`, not to this repo. fisher refuses to install a plugin
# when any of its files already exists while the plugin is missing from fisher's
# registry, so a vendored copy of even ONE file wedges the whole plugin: tide's
# prompt file had been committed here, fisher then refused to install tide's 50
# supporting functions, and every prompt drew "Unknown command: _tide_pwd".
# fish_plugins (tracked) is the manifest; `fisher update` materialises these.
# The .yadmtrack hook under .config/fish/functions and .config/fish/conf.d
# respects this file, which is what stops them being committed again.
# Regenerate after adding or removing plugins:
#   fish -c 'for v in (set --names --universal | string match "_fisher_*_files"); for p in $$v; string replace "~/" "" $p; end; end' | sort -u
.config/fish/completions/fisher.fish
.config/fish/completions/fzf_configure_bindings.fish
.config/fish/completions/nvm.fish
.config/fish/completions/tide.fish
.config/fish/conf.d/_tide_init.fish
.config/fish/conf.d/autopair.fish
.config/fish/conf.d/bak.fish
.config/fish/conf.d/fish_auto_source.fish
.config/fish/conf.d/fzf.fish
.config/fish/conf.d/magic-enter.fish
.config/fish/conf.d/nvm.fish
.config/fish/conf.d/park.fish
.config/fish/conf.d/plugin-bang-bang.fish
.config/fish/functions/__bak.fish
.config/fish/functions/__bak_help.fish
