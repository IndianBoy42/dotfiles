{
  "$schema": "https://opencode.ai/config.json",
  // "model": "opencode/claude-sonnet-4-5",
  // "model": "zai-coding-plan/glm-4.7",
  // "model": "opencode-go/kimi-k2.5",
  // "model": "opencode-go/kimi-k2.5",
  "model": "synthetic/hf:moonshotai/Kimi-K2.5",
  // "small_model": "opencode/minimax-m2.5-free",
  "small_model": "opencode-go/minimax-m2.7",
  "compaction": {
    "auto": false,
  },
  "provider": {
    // "inception": {
    //   "models": {
    //     "mercury-2": {
    //       "id": "mercury-2",
    //       "name": "Mercury 2",
    //       "family": "mercury",
    //       "release_date": "Feb 2026",
    //       "attachment": false,
    //       "reasoning": true,
    //       "temperature": true,
    //       "tool_call": true,
    //       "limit": {
    //         "context": 128000,
    //         "output": 16384,
    //       },
    //       "modalities": {
    //         "input": ["text"],
    //         "output": ["text"],
    //       },
    //       "options": {},
    //     },
    //   },
    // },
  },
  "experimental": {
    "batch_tool": true,
    "lsp": true,
    "plan": true,
  },
  "permission": {
    "external_directory": {
      "/tmp/*": "allow",
      "*": "ask",
    },
    "read": {
      "**/.env": "deny",
    },
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    // "@mohak34/opencode-notifier@latest",
  ],
  "autoshare": false,
  "autoupdate": false,
  "lsp": {
    "pyright": { "disabled": true },
    "lua-ls": { "disabled": true },
    "clangd": {
      "command": [
        "clangd",
        "--background-index",
        "--query-driver=**/arm-none-eabi-*,**/x86_64-linux-*",
      ],
    },
  },
  "mcp": {
    "jupyter": {
      "enabled": false,
      "type": "local",
      "command": ["uvx", "jupyter-mcp-server@latest"],
      "environment": {
        "JUPYTER_URL": "http://localhost:8888",
        "JUPYTER_TOKEN": "{env:JUPYTER_TOKEN}",
        "ALLOW_IMG_OUTPUT": "true",
      },
    },
    "perplexity": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "@chatmcp/server-perplexity-ask"],
    },
    "ast-grep": {
      "type": "local",
      "enabled": false,
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/ast-grep/ast-grep-mcp",
        "ast-grep-server",
      ],
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false,
    },
  },
  "command": {
    "commit": {
      "template": "Commit Message: $ARGUMENTS",
      "subtask": true,
      "model": "opencode/minimax-m2.5-free", // Free
    },
  },
  "default_agent": "coordinator",
  "agent": {
    "plan": {
      "model": "github-copilot/claude-sonnet-4.6",
    },
  },
}
