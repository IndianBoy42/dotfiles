{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "experimental": {
    "allowSubAgents": true,
  },
  // Keep notifications visible but not noisy
  "pruneNotification": "minimal",
  "pruneNotificationType": "toast",

  // Keep question prompts intact when sweeping manually
  "commands": {
    "protectedTools": ["question"],
  },
  "compress": {
    "maxContextLimit": "90%",
    "minContextLimit": 100000,
    // TODO: 1M context models should actually be nudged earlier to avoid costs and degradation
    // "minContextLimit": "20%",
    "modelMinLimits": {
      // GLM-5.1 gets REALLY bad after 128k
      "plexus/glm-5.1": "30%",
      "opencode-go/glm-5.1": "30%",
      "synthetic/hf:zai-org/GLM-5.1": "30%",
      "neuralwatt/zai-org/GLM-5.1-FP8": "30%",
    },
    "modelMaxLimits": {
      // GLM-5.1 gets REALLY bad after 128k
      "plexus/glm-5.1": "50%",
      "opencode-go/glm-5.1": "50%",
      "synthetic/hf:zai-org/GLM-5.1": "50%",
      "neuralwatt/zai-org/GLM-5.1-FP8": "50%",
      // 1M Context models, should prune earlier to save cost
      "opencode-go/mimo-v2.5-pro": 250000,
      "xiaomi/mimo-v2.5-pro": 250000,
      "opencode-go/deepseek-v4-flash": 400000,
      "deepseek/deepseek-v4-flash": 400000,
    },
    "nudgeForce": "soft",
    "nudgeFrequency": 10,
    "protectUserMessages": false,
    "protectedTools": ["skill"],
  },
  // Protect only the freshest tools; older ones can be deduped/purged sooner
  "turnProtection": {
    "enabled": false,
    "turns": 2,
  },
  // Faster error cleanup — failed tool calls are noise after 2 turns
  "strategies": {
    "purgeErrors": {
      "turns": 2,
    },
  },
}
